<UserControl x:Class="Plugin.ReusableMeasureDetect.PointFilters.Controls.FilterUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Plugin.ReusableMeasureDetect.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource Surface.PanelDeep.Color}"/>
        <SolidColorBrush x:Key="PanelDarkBrush" Color="{DynamicResource Surface.PanelDeep.Color}"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource Surface.PanelDeep.Color}"/>
        <SolidColorBrush x:Key="BorderBrushValue" Color="{DynamicResource Line.Normal.Color}"/>
        <SolidColorBrush x:Key="BorderSoftBrush" Color="{DynamicResource Line.Normal.Color}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource Accent.Secondary.Color}"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource Accent.Primary.Color}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource Text.Primary.Color}"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource Text.Secondary.Color}"/>

        <Style x:Key="ComboToggleButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Chrome"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <Path Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,8,0" Fill="{StaticResource AccentSoftBrush}"
                                  Data="M 0 0 L 8 0 L 4 5 Z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.PanelDeep}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.PanelDeep}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.PanelDeep}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Background="{StaticResource PanelBackgroundBrush}">
        <CheckBox Content="启用点集滤波" IsChecked="{Binding EnableFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox Content="显示当前选择点集" IsChecked="{Binding ShowSelectedPointSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <UniformGrid Columns="2" Margin="0,0,0,6">
            <TextBlock Text="滤波前排序"/>
            <ComboBox SelectedValue="{Binding FilterPreSortMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                <ComboBoxItem Content="None" Tag="None"/>
                <ComboBoxItem Content="Row" Tag="Row"/>
                <ComboBoxItem Content="Col" Tag="Col"/>
            </ComboBox>
            <TextBlock Text="检测步骤"/>
            <ComboBox ItemsSource="{Binding FilterStepItems}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedFilterStep, Mode=TwoWay}"/>
            <TextBlock Text="Cross 尺寸"/>
            <controls:NumericBox Value="{Binding FilterCrossSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="2" DecimalPlaces="2" Increment="1"/>
        </UniformGrid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="118"/>
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" Height="128" ItemsSource="{Binding FilterPipeline}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"/>
            <StackPanel Grid.Column="1" Margin="6,0,0,0" Background="{StaticResource PanelBackgroundBrush}">
                <ComboBox ItemsSource="{Binding AvailableFilters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedAvailableFilter, Mode=TwoWay}"/>
                <Button Style="{StaticResource ToolButton}" Content="添加" Command="{Binding AddFilterCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="删除" Command="{Binding DeleteFilterCommand}"/>
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource ToolButton}" Content="上移" Command="{Binding MoveFilterUpCommand}" Margin="0,0,2,0"/>
                    <Button Style="{StaticResource ToolButton}" Content="下移" Command="{Binding MoveFilterDownCommand}" Margin="2,0,0,0"/>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Background="{StaticResource PanelDarkBrush}" Padding="8">
            <StackPanel Background="{StaticResource PanelDarkBrush}">
                <TextBlock Text="{Binding SelectedFilterParamTitle}" Margin="0,0,0,6"/>
                <TextBlock Text="请先添加并选择一个滤波器"
                           Foreground="{StaticResource MutedTextBrush}"
                           Visibility="{Binding HasNoSelectedFilter, Converter={StaticResource BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding SelectedFilterParameterFields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}"/>
                                <controls:NumericBox Grid.Column="1" Value="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-100000000" DecimalPlaces="{Binding DecimalPlaces}" Increment="{Binding Increment}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
