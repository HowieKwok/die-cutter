<UserControl
    x:Class="DevMgmt.Cameras.View.DynamicCameraParamUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DevMgmt.Cameras.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="630"
    d:DesignWidth="390"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!-- 其余外观由 Frame_UI.Wpf/Theme/ThemeResources.xaml 的隐式样式提供，此处只保留本视图的具名变体。 -->
        <Style x:Key="PathSelectBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="35" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Secondary}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Surface.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="1"
            Padding="1,0"
            Background="{DynamicResource Surface.PanelDeep}"
            BorderBrush="{DynamicResource Accent.Primary}"
            BorderThickness="1">
            <ScrollViewer
                Padding="10"
                Background="{DynamicResource Surface.PanelDeep}"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MainStackPanel" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
