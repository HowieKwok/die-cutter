<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        只描述结构与尺寸。所有颜色通过 DynamicResource 引用 ThemeScope 注入的键，
        本文件不出现任何十六进制色值（分层门禁会校验）。
        可用键见 Frame_UI.Wpf/Hosting/ThemeScope.cs 的 ThemeKeys 常量。
    -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <ControlTemplate x:Key="Button.Template" TargetType="Button">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Radius.Input}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.HoverBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Hint}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line.Subtle}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource Metric.ControlHeight}" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Button.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Button.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
    </Style>

    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.Md}" />
        <Setter Property="Margin" Value="{DynamicResource Spacing.Sm}" />
    </Style>

    <Style x:Key="CommandGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Canvas}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
        <Style.Triggers>
            <!-- 禁用态文字统一压灰：默认模板不区分 Enabled，字仍是最亮的主题色 -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Hint}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
    </Style>
    <!--
        ===== 隐式样式区 =====
        以下 Style 不带 x:Key，按 TargetType 自动作用于整棵子树。
        视图只要合并了本字典（ThemeScope.Ensure 会做），不写任何 Style 就获得统一外观。
        这里是全项目 WPF 外观的唯一来源：视图内不得再定义隐式 Style，否则会覆盖这里的定义。
    -->

    <!--
        隐式 Button 样式：默认模板在 hover 时会画出系统浅蓝底，与深色文字叠成“看不见字”，
        因此必须带模板。Button.Template 是扁平实现（Border + ContentPresenter），
        不改变按钮的尺寸与内容布局，只接管底色/边框/hover。
    -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Button.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Button.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
    </Style>

    <!--
        ComboBox 必须整模板替换：默认模板的下拉按钮与弹层用系统浅色绘制，
        设 Background 只能染到文本区一角（真机表现：白底下拉）。
    -->
    <Style x:Key="ComboBox.Toggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Input}">
                        <Grid>
                            <ContentPresenter Margin="6,0,24,0"
                                              VerticalAlignment="Center" />
                            <Path x:Name="Arrow"
                                  Width="8"
                                  Height="5"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Data="M0,0 L4,5 L8,0 Z"
                                  Fill="{DynamicResource Text.Secondary}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ComboBox.Template" TargetType="ComboBox">
        <Grid>
            <ToggleButton x:Name="ToggleButton"
                          ClickMode="Press"
                          Focusable="False"
                          Style="{StaticResource ComboBox.Toggle}"
                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Popup x:Name="Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PopupAnimation="Slide">
                <Border Background="{DynamicResource Surface.PanelDeep}"
                        BorderBrush="{DynamicResource Line.Normal}"
                        BorderThickness="1"
                        MaxHeight="260"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                    <ScrollViewer CanContentScroll="True">
                        <ItemsPresenter />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ComboBoxItem.Template" TargetType="ComboBoxItem">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.HoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selection.Background}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="Template" Value="{StaticResource ComboBox.Template}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Hint}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Line.Subtle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template" Value="{StaticResource ComboBoxItem.Template}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Hint}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Hint}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Hint}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="{DynamicResource Spacing.Sm}" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.Sm}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Selection.Background}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
        TabItem 同样需要模板：默认模板的 hover/选中态用系统浅色，
        深色文字叠上去会“看不见标签”。
    -->
    <ControlTemplate x:Key="TabItem.Template" TargetType="TabItem">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="0,0,0,2"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.HoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Canvas}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource TabItem.Template}" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Line.Divider}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Line.Normal}" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="RowBackground" Value="{DynamicResource Surface.Panel}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line.Divider}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Line.Divider}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Normal}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Divider}" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
</ResourceDictionary>