<UserControl
    x:Class="Mef_VisionFrame.调试设置.WPF.WPFDebugProcessView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="1220"
    Background="{DynamicResource Surface.Canvas}"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <!--
        本文件不再定义任何颜色或外观样式：
        Panel / Button.Primary / CommandGroup / TextBlock 默认样式
        全部来自 Frame_UI.Wpf，由 code-behind 在 InitializeComponent 之前注入。
    -->

    <Grid>
        <Grid.Background>
            <DrawingBrush
                Opacity="0.32"
                TileMode="Tile"
                Viewport="0,0,44,44"
                ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{DynamicResource Surface.Canvas}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,44,44" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{DynamicResource Grid.Line}">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,1,44" />
                                    <RectangleGeometry Rect="0,0,44,1" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="98" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{DynamicResource Surface.Canvas}"
            BorderBrush="{DynamicResource Line.Normal}"
            BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="{DynamicResource Accent.Primary}"
                        Text="调试流程界面" />
                    <TextBlock
                        x:Name="StatusText"
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource Accent.Muted}"
                        Text="状态：等待操作" />
                </StackPanel>
                <Grid
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CommandGroup}">
                        <DockPanel LastChildFill="True">
                            <TextBlock
                                Margin="4,0,0,4"
                                DockPanel.Dock="Top"
                                Foreground="{DynamicResource Accent.Muted}"
                                Text="流程控制" />
                            <WrapPanel>
                                <Button Click="BtnAddProcess_Click" Content="新建" Style="{StaticResource Button.Primary}" />
                                <Button Click="BtnDeleteProcess_Click" Content="删除" Style="{StaticResource Button.Primary}" />
                                <Button Click="BtnRebuild_Click" Content="重建" Style="{StaticResource Button.Primary}" />
                                <Button Click="BtnLoad_Click" Content="加载" Style="{StaticResource Button.Primary}" />
                                <Button Click="BtnSave_Click" Content="保存" Style="{StaticResource Button.Primary}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CommandGroup}">
                        <DockPanel LastChildFill="True">
                            <TextBlock
                                Margin="4,0,0,4"
                                DockPanel.Dock="Top"
                                Foreground="{DynamicResource Accent.Muted}"
                                Text="模块调试" />
                            <WrapPanel>
                                <Button Click="BtnAddModule_Click" Content="添加" Style="{StaticResource Button.Primary}" />
                                <Button Click="BtnDeleteModule_Click" Content="删除" Style="{StaticResource Button.Primary}" />
                                <Button Click="BtnRunOnce_Click" Content="运行一次" Style="{StaticResource Button.Primary}" />
                                <Button Click="BtnRunLoop_Click" Content="循环" Style="{StaticResource Button.Primary}" />
                                <Button Click="BtnRunStop_Click" Content="停止" Style="{StaticResource Button.Primary}" />
                                <Button
                                    x:Name="BtnToggleContainerTop"
                                    Click="BtnToggleContainer_Click"
                                    Content="隐藏容器"
                                    Style="{StaticResource Button.Primary}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*" />
                <ColumnDefinition Width="5.5*" />
                <ColumnDefinition x:Name="PluginContainerColumn" Width="360" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,14" DockPanel.Dock="Top" Text="流程列表" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProcessPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,14" DockPanel.Dock="Top" Text="模块列表" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SelectedModulePanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border
                x:Name="PluginContainerPanel"
                Grid.Column="2"
                Style="{StaticResource Panel}">
                <DockPanel>
                    <Grid Margin="0,0,0,14" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Text="模块容器" />
                        <Button
                            Grid.Column="1"
                            MinWidth="64"
                            Click="BtnToggleContainer_Click"
                            Content="收起"
                            Style="{StaticResource Button.Primary}" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PluginCategoryPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>