<Window
    x:Class="DevMgmt.Cameras.View.AddCameraWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DevMgmt.Cameras.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="500"
    MinHeight="250"
    d:DesignHeight="250"
    d:DesignWidth="500"
    Background="{DynamicResource Surface.Canvas}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <!--  样式，风格完全统一  -->
    <Window.Resources>
        <!-- 其余外观由 Frame_UI.Wpf/Theme/ThemeResources.xaml 的隐式样式提供，此处只保留本窗口的具名变体。 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Surface.PanelDeep}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Secondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Padding="10"
            Background="{DynamicResource Surface.PanelDeep}"
            BorderBrush="{DynamicResource Accent.Primary}"
            BorderThickness="0,0,0,1">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Foreground="{DynamicResource Accent.Secondary}"
                Text="请选择相机类型" />
        </Border>

        <!--  单选框区域（自适应换行，不会挤成一条）  -->
        <ItemsControl
            Grid.Row="1"
            Margin="15"
            ItemsSource="{Binding AllCamTypes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                    <!--<WrapPanel Orientation="Horizontal" />-->
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton
                        Margin="15,8"
                        Content="{Binding DisplayName}"
                        Foreground="{DynamicResource Text.Primary}"
                        GroupName="CameraGroup"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  底部按钮（自动贴右下角）  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Width="90"
                Height="30"
                Background="{DynamicResource Surface.PanelDeep}"
                BorderBrush="{DynamicResource Accent.Primary}"
                Command="{Binding ConfirmCommand}"
                Content="确定"
                Foreground="White"
                IsEnabled="{Binding CanConfirm}" />
        </StackPanel>
    </Grid>
</Window>
