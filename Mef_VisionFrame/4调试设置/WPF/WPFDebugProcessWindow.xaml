<ui:ThemedWindow
    x:Class="Mef_VisionFrame.调试设置.WPF.WPFDebugProcessWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Mef_VisionFrame.调试设置.WPF"
    xmlns:ui="clr-namespace:Frame_UI.Wpf;assembly=Frame_UI.Wpf"
    Title="{Binding WindowTitle}"
    Width="1280"
    Height="820"
    MinWidth="1040"
    MinHeight="680"
    WindowStartupLocation="CenterScreen">
    <!--
        窗口外壳（标题栏、边框、最小化/最大化/关闭）由 Frame_UI.Wpf 提供，
        本窗口只描述内容。不要再在这里定义 WindowChrome 或标题栏按钮。
        关闭语义由 Form_Main 决定（拦截 Closing 改为隐藏）。
    -->
    <local:WPFDebugProcessView />
</ui:ThemedWindow>